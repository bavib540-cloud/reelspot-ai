.env.example

# Supabase (client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server - service role, keep secret)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Optional payment gateway credentials (for automated webhooks)
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Routing Service (optional)
ROUTING_API_URL=
ROUTING_API_KEY=

# Weather (optional)
OPENWEATHER_API_KEY=

# App
VITE_APP_BASE_URL=http://localhost:5173
